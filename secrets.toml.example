# Copie este arquivo para .streamlit/secrets.toml (mesma pasta do app.py,
# dentro de uma subpasta chamada .streamlit) e preencha com os valores
# reais do SESSION POOLER do seu projeto Supabase.
#
# Onde pegar: painel do Supabase → Connect → aba "Session pooler"
# (NÃO use a aba "Direct connection" — ela é IPv6-only e costuma falhar
# a partir do Streamlit Community Cloud).
#
# host: algo como aws-0-REGIAO.pooler.supabase.com
# port: 5432 (session pooler, não 6543 — 6543 é o transaction pooler)
# username: postgres.SEU_PROJECT_REF (com o ponto, não é só "postgres")
# password: a senha do banco que você definiu ao criar o projeto
#
# NUNCA envie o secrets.toml real pro GitHub — adicione
# ".streamlit/secrets.toml" no seu .gitignore.
#
# No Streamlit Cloud, esses mesmos valores vão em:
# App settings > Secrets (colado direto na interface, não é upload de arquivo).

[connections.postgresql]
dialect = "postgresql"
host = "aws-0-REGIAO.pooler.supabase.com"
port = 5432
database = "postgres"
username = "postgres.SEU_PROJECT_REF"
password = "SUA_SENHA_DO_BANCO"
